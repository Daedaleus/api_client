meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  ~X-Debug: 1
}

body:json {
  {
    "user": "alice",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}
